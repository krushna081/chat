# RelayChat single-service environment
# Copy this file to .env and replace every placeholder. Never commit .env.

# Runtime
NODE_ENV=development
PORT=5000
# Leave blank for safe defaults: false locally, 1 in production behind one proxy.
TRUST_PROXY=
# Public URL of the single service. In production this is required.
CLIENT_URL=http://localhost:5173
# Optional extra browser origins, comma separated.
ALLOWED_ORIGINS=

# MongoDB Atlas connection string. Keep it secret.
MONGODB_URI=mongodb://127.0.0.1:27017/relaychat
# Optional DNS servers for restricted networks, comma separated.
MONGODB_DNS_SERVERS=

# Generate two different 32+ character secrets:
#   openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Cookies. Leave COOKIE_SECURE blank for safe defaults: false locally, true in production.
# Same-origin single-service deployments should use lax + secure in production.
COOKIE_SECURE=
COOKIE_SAME_SITE=lax
# Optional cookie domain, for example .example.com. Usually leave blank.
COOKIE_DOMAIN=
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Email (Resend). Without a key, development logs the OTP to the server console.
RESEND_API_KEY=
EMAIL_FROM=RelayChat <onboarding@resend.dev>
# Optional development-only redirect for test emails.
RESEND_TEST_EMAIL=

# Single-server static client serving. Build the client before starting.
SERVE_CLIENT=true
CLIENT_DIST=client/dist
